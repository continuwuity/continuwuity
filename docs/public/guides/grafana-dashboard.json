          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum(rate(continuwuity_http_request_duration_seconds_count{instance=~\"$instance\",status=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(continuwuity_http_request_duration_seconds_count{instance=~\"$instance\"}[$__rate_interval]))",
